{
  "title": "Saude de Pod/Workload",
  "uid": "pod-workload-health",
  "tags": ["paineis-operacionais"],
  "timezone": "utc",
  "editable": false,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Pods fora de Running",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_status_phase{phase!=\"Running\", phase!=\"Succeeded\"} == 1",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Reinicios por pod (ultimas 24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod) (kube_pod_container_status_restarts_total)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Replicas esperadas vs. prontas (Deployment)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_spec_replicas",
          "legendFormat": "{{namespace}}/{{deployment}} esperadas"
        },
        {
          "refId": "B",
          "expr": "kube_deployment_status_replicas_ready",
          "legendFormat": "{{namespace}}/{{deployment}} prontas"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Consumo real de CPU por conteiner",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod, container) (rate(container_cpu_usage_seconds_total{container!=\"\"}[5m]))",
          "legendFormat": "{{namespace}}/{{pod}}/{{container}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Consumo real de memoria por conteiner",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod, container) (container_memory_working_set_bytes{container!=\"\"})",
          "legendFormat": "{{namespace}}/{{pod}}/{{container}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    }
  ]
}
